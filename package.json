{
  "name": "turing-complete-game-lab",
  "version": "0.1.0",
  "description": "Hello World Bun Template",
  "scripts": {
    "index": "bun run src/index.ts",
    "format": "bunx prettier . --write",
    "typecheck": "bunx tsc --noEmit",
    "clean:traces": "bun -e \"import { rm } from 'node:fs/promises'; await rm('artifacts/traces', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@drsmile1001/config-factory": "^0.1.0",
    "@drsmile1001/logger": "^0.1.0",
    "@drsmile1001/testkit": "^0.1.1",
    "@drsmile1001/utils": "^0.1.0",
    "@sinclair/typebox": "^0.34.48",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "^1.3.9",
    "prettier": "^3.8.1"
  }
}
